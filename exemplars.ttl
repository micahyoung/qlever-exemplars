@prefix unit:  <https://w3id.org/OWLunit/ontology/> .
@prefix ex:    <https://example.org/qlever/wikidata-truthy/cq/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Ontology / dataset under test
#################################################################

ex:WikidataTruthyDataset a owl:Ontology ;
    rdfs:label "Wikidata truthy (QLever local endpoint)" .

#################################################################
# CQ1 — Entity attribute lookup
#################################################################

ex:CQ1 a unit:CompetencyQuestionVerification ;
    rdfs:label "CQ1 - Entity attribute lookup" ;
    unit:testsOntology ex:WikidataTruthyDataset ;
    unit:hasInputTestDataCategory unit:SPARQLendpoint ;
    unit:hasCompetencyQuestion "When was Marie Curie born, and what was her date of death?" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>

SELECT ?item ?label ?birth ?death WHERE {
  { ?item rdfs:label "Marie Curie"@en }
  UNION
  { ?item rdfs:label "Marie Sklodowska-Curie"@en }
  ?item wdt:P31 wd:Q5 ;
        wdt:P569 ?birth ;
        rdfs:label ?label .
  OPTIONAL { ?item wdt:P570 ?death }
  FILTER(LANG(?label) = "en")
}
""" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX mwapi: <https://www.mediawiki.org/ontology#API/>

SELECT ?item ?label ?birth ?death WHERE {
  # mwapi:searchRelation resolves a "?x is-P Q" pair jointly (here: item is
  # an instance of "human") instead of two blind lookups -- see the SERVICE
  # syntax reference in CLAUDE.md. Split into two calls, one per output
  # variable, per that same reference (a single call binding both into one
  # triple can defeat QLever's planner); the repeat call is cache-cheap.
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:searchRelation "instance of human" ;
       mwapi:bindProperty ?instanceOfProp ;
       mwapi:bindItem ?humanItemA .
  }
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:searchRelation "instance of human" ;
       mwapi:bindProperty ?instanceOfPropB ;
       mwapi:bindItem ?humanItem .
  }
  # mwapi:bind batches unrelated phrases ("date of birth", "date of death")
  # into one round trip -- no joint-context benefit needed here, just fewer
  # requests.
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:search "date of birth" ; mwapi:type "property" ; mwapi:bind ?birthProp .
    [] mwapi:search "date of death" ; mwapi:type "property" ; mwapi:bind ?deathProp .
  }
  { ?item rdfs:label "Marie Curie"@en }
  UNION
  { ?item rdfs:label "Marie Sklodowska-Curie"@en }
  ?item ?instanceOfProp ?humanItem ;
        ?birthProp ?birth ;
        rdfs:label ?label .
  OPTIONAL { ?item ?deathProp ?death }
  FILTER(LANG(?label) = "en")
}
""" .

#################################################################
# CQ2 — Relationship / hierarchy traversal
#################################################################

# No SERVICE variant: this CQ's only predicate is wdt:P131+, and SPARQL
# property-path modifiers (+/*) cannot be applied to a variable predicate —
# QLever rejects "?prop+" as a parse error. The property must stay a
# hardcoded IRI, so there is nothing left for SERVICE to resolve.
ex:CQ2 a unit:CompetencyQuestionVerification ;
    rdfs:label "CQ2 - Hierarchy traversal" ;
    unit:testsOntology ex:WikidataTruthyDataset ;
    unit:hasInputTestDataCategory unit:SPARQLendpoint ;
    unit:hasCompetencyQuestion "What entities fall under the administrative/locational hierarchy of Gweru, Zimbabwe?" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>

SELECT ?item ?label WHERE {
  ?item wdt:P131+ wd:Q399316 .
  ?item rdfs:label ?label . FILTER(LANG(?label)="en")
} LIMIT 20
""" .

#################################################################
# CQ3 — Multi-hop join
#################################################################

ex:CQ3 a unit:CompetencyQuestionVerification ;
    rdfs:label "CQ3 - Multi-hop join" ;
    unit:testsOntology ex:WikidataTruthyDataset ;
    unit:hasInputTestDataCategory unit:SPARQLendpoint ;
    unit:hasCompetencyQuestion "Which cities in Germany have a population over 500,000 and were founded before the year 1200?" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?city ?label ?pop ?inception WHERE {
  ?city wdt:P17 wd:Q183 .
  ?city wdt:P31/wdt:P279* wd:Q515 .
  ?city wdt:P1082 ?pop .
  ?city wdt:P571 ?inception .
  FILTER(?pop > 500000)
  FILTER(?inception < "1200-01-01T00:00:00"^^xsd:dateTime)
  ?city rdfs:label ?label . FILTER(LANG(?label)="en")
} ORDER BY ?inception
""" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX mwapi: <https://www.mediawiki.org/ontology#API/>

SELECT DISTINCT ?city ?label ?pop ?inception WHERE {
  # mwapi:bind for all five phrases -- NOT mwapi:searchRelation for
  # "instance of"/"city", because they're not directly related here:
  # ?instanceOfProp's object is ?cls, joined to ?cityClass through a
  # wdt:P279* subclass hop, not the same triple.
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:search "country" ; mwapi:type "property" ; mwapi:bind ?countryProp .
    [] mwapi:search "instance of" ; mwapi:type "property" ; mwapi:bind ?instanceOfProp .
    [] mwapi:search "population" ; mwapi:type "property" ; mwapi:bind ?popProp .
    [] mwapi:search "inception" ; mwapi:type "property" ; mwapi:bind ?inceptionProp .
    [] mwapi:search "city" ; mwapi:type "item" ; mwapi:bind ?cityClass .
  }
  ?city ?countryProp wd:Q183 .
  ?city ?instanceOfProp ?cls .
  ?cls wdt:P279* ?cityClass .
  ?city ?popProp ?pop .
  ?city ?inceptionProp ?inception .
  FILTER(?pop > 500000)
  FILTER(?inception < "1200-01-01T00:00:00"^^xsd:dateTime)
  ?city rdfs:label ?label . FILTER(LANG(?label)="en")
} ORDER BY ?inception
""" .

#################################################################
# CQ4 — Aggregation / ranking
#################################################################

ex:CQ4 a unit:CompetencyQuestionVerification ;
    rdfs:label "CQ4 - Aggregation and ranking" ;
    unit:testsOntology ex:WikidataTruthyDataset ;
    unit:hasInputTestDataCategory unit:SPARQLendpoint ;
    unit:hasCompetencyQuestion "Which countries have produced the most Nobel Prize laureates in Physics, ranked from most to least?" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>

SELECT ?countryLabel (COUNT(DISTINCT ?person) AS ?count) WHERE {
  ?person wdt:P166 wd:Q38104 .
  ?person wdt:P27 ?country .
  ?country rdfs:label ?countryLabel . FILTER(LANG(?countryLabel)="en")
} GROUP BY ?countryLabel ORDER BY DESC(?count) LIMIT 10
""" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX mwapi: <https://www.mediawiki.org/ontology#API/>

SELECT ?countryLabel (COUNT(DISTINCT ?person) AS ?count) WHERE {
  # mwapi:searchRelation, split across two calls (see CQ1). Joint context
  # here disambiguates "award received" from the individually-plausible
  # "nominated for".
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:searchRelation "received the Nobel Prize in Physics" ;
       mwapi:bindProperty ?awardProp ;
       mwapi:bindItem ?nobelPhysicsA .
  }
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:searchRelation "received the Nobel Prize in Physics" ;
       mwapi:bindProperty ?awardPropB ;
       mwapi:bindItem ?nobelPhysics .
  }
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:search "country of citizenship" ; mwapi:type "property" ; mwapi:bind ?citizenshipProp .
  }
  ?person ?awardProp ?nobelPhysics .
  ?person ?citizenshipProp ?country .
  ?country rdfs:label ?countryLabel . FILTER(LANG(?countryLabel)="en")
} GROUP BY ?countryLabel ORDER BY DESC(?count) LIMIT 10
""" .

#################################################################
# CQ5 — Disambiguation via type/context constraints
#################################################################

ex:CQ5 a unit:CompetencyQuestionVerification ;
    rdfs:label "CQ5 - Disambiguation via context constraint" ;
    unit:testsOntology ex:WikidataTruthyDataset ;
    unit:hasInputTestDataCategory unit:SPARQLendpoint ;
    unit:hasCompetencyQuestion "What is the population of Springfield, Illinois?" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>

SELECT DISTINCT ?item ?label ?pop WHERE {
  ?item rdfs:label "Springfield"@en .
  ?item wdt:P131* wd:Q1204 .
  ?item wdt:P1082 ?pop .
  BIND("Springfield"@en AS ?label)
}
""" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX mwapi: <https://www.mediawiki.org/ontology#API/>
PREFIX bd: <http://www.bigdata.com/rdf#>

SELECT DISTINCT ?item ?label ?pop WHERE {
  SERVICE <http://localhost:7002/sparql> {
    bd:serviceParam mwapi:search "population" .
    bd:serviceParam mwapi:type "property" .
    bd:serviceParam wikibase:limit "1" .
    ?popProp wikibase:apiOutput mwapi:directProperty .
  }
  ?item rdfs:label "Springfield"@en .
  ?item wdt:P131* wd:Q1204 .
  ?item ?popProp ?pop .
  BIND("Springfield"@en AS ?label)
}
""" .

#################################################################
# CQ6 — Cross-domain fact linking
#################################################################

ex:CQ6 a unit:CompetencyQuestionVerification ;
    rdfs:label "CQ6 - Cross-domain fact linking" ;
    unit:testsOntology ex:WikidataTruthyDataset ;
    unit:hasInputTestDataCategory unit:SPARQLendpoint ;
    unit:hasCompetencyQuestion "Which breweries headquartered in national capitals were founded before 1900?" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?company ?label ?cityLabel ?inception WHERE {
  ?city wdt:P1376 ?country .
  ?company wdt:P159 ?city .
  ?company wdt:P31 wd:Q131734 .
  ?company wdt:P571 ?inception .
  FILTER(?inception < "1900-01-01T00:00:00"^^xsd:dateTime)
  ?company rdfs:label ?label . FILTER(LANG(?label)="en")
  ?city rdfs:label ?cityLabel . FILTER(LANG(?cityLabel)="en")
} ORDER BY ?inception LIMIT 15
""" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX mwapi: <https://www.mediawiki.org/ontology#API/>

SELECT DISTINCT ?company ?label ?cityLabel ?inception WHERE {
  # mwapi:searchRelation, split across two calls (see CQ1). Unlike CQ3,
  # ?company ?instanceOfProp ?breweryClass is a direct triple, so the
  # relation form's live-verification applies cleanly here.
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:searchRelation "instance of brewery" ;
       mwapi:bindProperty ?instanceOfProp ;
       mwapi:bindItem ?breweryClassA .
  }
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:searchRelation "instance of brewery" ;
       mwapi:bindProperty ?instanceOfPropB ;
       mwapi:bindItem ?breweryClass .
  }
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:search "capital of" ; mwapi:type "property" ; mwapi:bind ?capitalOfProp .
    [] mwapi:search "headquarters location" ; mwapi:type "property" ; mwapi:bind ?hqProp .
    [] mwapi:search "inception" ; mwapi:type "property" ; mwapi:bind ?inceptionProp .
  }
  ?city ?capitalOfProp ?country .
  ?company ?hqProp ?city .
  ?company ?inceptionProp ?inception .
  FILTER(?inception < "1900-01-01T00:00:00"^^xsd:dateTime)
  ?company ?instanceOfProp ?breweryClass .
  ?company rdfs:label ?label . FILTER(LANG(?label)="en")
  ?city rdfs:label ?cityLabel . FILTER(LANG(?cityLabel)="en")
} ORDER BY ?inception LIMIT 15
""" .

#################################################################
# CQ7 — Bounded-depth hierarchy traversal, fully dynamic
#
# Variant of CQ2 that avoids the wdt:P131+ property-path modifier (which
# cannot be applied to a SERVICE-resolved variable predicate) by unrolling
# two explicit hops instead of unbounded recursion. Nothing is hardcoded:
# the entity is resolved via rdfs:label, and the property is resolved twice
# via SERVICE (once per hop, under separate variable names) rather than
# reused across both triples — reusing one SERVICE-bound variable across two
# index scans defeats QLever's query planner and forces an unconstrained
# ~65GB scan.
#################################################################

ex:CQ7 a unit:CompetencyQuestionVerification ;
    rdfs:label "CQ7 - Bounded-depth hierarchy traversal (dynamic CQ2 variant)" ;
    unit:testsOntology ex:WikidataTruthyDataset ;
    unit:hasInputTestDataCategory unit:SPARQLendpoint ;
    unit:hasCompetencyQuestion "What are Gweru, Zimbabwe's parent administrative region and that region's parent country?" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX mwapi: <https://www.mediawiki.org/ontology#API/>

SELECT ?regionLabel ?countryLabel WHERE {
  # mwapi:bind: the same phrase resolved twice into distinct variables
  # (?locatedInProp1/?locatedInProp2), one round trip -- each hop still
  # gets its own SPARQL variable, which is what this CQ's header comment
  # requires.
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:search "located in the administrative territorial entity" ; mwapi:type "property" ; mwapi:bind ?locatedInProp1 .
    [] mwapi:search "located in the administrative territorial entity" ; mwapi:type "property" ; mwapi:bind ?locatedInProp2 .
  }
  ?gweru rdfs:label "Gweru"@en .
  ?gweru ?locatedInProp1 ?region .
  ?region ?locatedInProp2 ?country .
  ?region rdfs:label ?regionLabel . FILTER(LANG(?regionLabel)="en")
  ?country rdfs:label ?countryLabel . FILTER(LANG(?countryLabel)="en")
}
""" .

#################################################################
# CQ8 — Disambiguation via single-hop relation, fully dynamic
#
# Variant of CQ5 that avoids the wdt:P131* property-path modifier by
# disambiguating "Springfield" through a single-hop "capital" relation
# (P36) instead of an unbounded administrative-hierarchy walk. Nothing is
# hardcoded: "Illinois" resolves via rdfs:label (12 label-alike candidates
# exist, but only the real state has a P36 capital with a P1082 population,
# so the join naturally disambiguates it), and both properties resolve via
# SERVICE.
#################################################################

ex:CQ8 a unit:CompetencyQuestionVerification ;
    rdfs:label "CQ8 - Disambiguation via single-hop relation (dynamic CQ5 variant)" ;
    unit:testsOntology ex:WikidataTruthyDataset ;
    unit:hasInputTestDataCategory unit:SPARQLendpoint ;
    unit:hasCompetencyQuestion "What is the population of the Springfield that is the capital of Illinois?" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX mwapi: <https://www.mediawiki.org/ontology#API/>
PREFIX bd: <http://www.bigdata.com/rdf#>

SELECT ?item ?label ?pop WHERE {
  SERVICE <http://localhost:7002/sparql> {
    bd:serviceParam mwapi:search "capital" .
    bd:serviceParam mwapi:type "property" .
    bd:serviceParam wikibase:limit "1" .
    ?capitalProp wikibase:apiOutput mwapi:directProperty .
  }
  SERVICE <http://localhost:7002/sparql> {
    bd:serviceParam mwapi:search "population" .
    bd:serviceParam mwapi:type "property" .
    bd:serviceParam wikibase:limit "1" .
    ?popProp wikibase:apiOutput mwapi:directProperty .
  }
  ?illinois rdfs:label "Illinois"@en .
  ?illinois ?capitalProp ?item .
  ?item ?popProp ?pop .
  ?item rdfs:label ?label . FILTER(LANG(?label)="en")
}
""" .
