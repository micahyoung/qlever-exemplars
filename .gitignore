# Claude Code local settings
.claude/settings.local.json

# QLever index and vocabulary files
wikidata-truthy/*.nt.bz2
wikidata-truthy/*.index.*
wikidata-truthy/*.internal.index.*
wikidata-truthy/*.vocabulary.*
wikidata-truthy/*.meta-data.json
wikidata-truthy/*.settings.json
wikidata-truthy/*-log.txt
wikidata-truthy/*.ops
wikidata-truthy/*.ops.meta
