# Property-search service: venv + generated embedding index (rebuild via build_index.py)
wikidata-property-search/.venv/
wikidata-property-search/index/

# Pattern for any future dataset directories
*/*.nt.bz2
*/*.index.*
*/*.internal.index.*
*/*.vocabulary.*
*/*.meta-data.json
*/*.settings.json
*/*-log.txt
