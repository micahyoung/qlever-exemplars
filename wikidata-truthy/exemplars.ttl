@prefix unit:  <https://w3id.org/OWLunit/ontology/> .
@prefix ex:    <https://example.org/qlever/wikidata-truthy/cq/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Ontology / dataset under test
#################################################################

ex:WikidataTruthyDataset a owl:Ontology ;
    rdfs:label "Wikidata truthy (QLever local endpoint)" .

#################################################################
# CQ1 — Entity attribute lookup
#################################################################

ex:CQ1 a unit:CompetencyQuestionVerification ;
    rdfs:label "CQ1 - Entity attribute lookup" ;
    unit:testsOntology ex:WikidataTruthyDataset ;
    unit:hasInputTestDataCategory unit:SPARQLendpoint ;
    unit:hasCompetencyQuestion "When was Marie Curie born, and what was her date of death?" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>

SELECT ?item ?label ?birth ?death WHERE {
  { ?item rdfs:label "Marie Curie"@en }
  UNION
  { ?item rdfs:label "Marie Sklodowska-Curie"@en }
  ?item wdt:P31 wd:Q5 ;
        wdt:P569 ?birth ;
        rdfs:label ?label .
  OPTIONAL { ?item wdt:P570 ?death }
  FILTER(LANG(?label) = "en")
}
""" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX mwapi: <https://www.mediawiki.org/ontology#API/>

SELECT ?item ?label ?birth ?death WHERE {
  # mwapi:bind batches unrelated phrases ("date of birth", "date of death")
  # into one round trip -- no joint-context benefit needed here, just fewer
  # requests.
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:search "date of birth" ; mwapi:type "property" ; mwapi:bind ?birthProp .
    [] mwapi:search "date of death" ; mwapi:type "property" ; mwapi:bind ?deathProp .
  }
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:searchRelation "instance of human" ;
       mwapi:bindProperty ?instanceOfProp ;
       mwapi:bindItem ?humanItem .
  }
  { ?item rdfs:label "Marie Curie"@en }
  UNION
  { ?item rdfs:label "Marie Sklodowska-Curie"@en }
  ?item ?instanceOfProp ?humanItem .
  ?item ?birthProp ?birth ;
        rdfs:label ?label .
  OPTIONAL { ?item ?deathProp ?death }
  FILTER(LANG(?label) = "en")
}
""" .

#################################################################
# CQ2 — Relationship / hierarchy traversal
#################################################################

# No SERVICE variant: this CQ's only predicate is wdt:P131+, and SPARQL
# property-path modifiers (+/*) cannot be applied to a variable predicate —
# QLever rejects "?prop+" as a parse error. The property must stay a
# hardcoded IRI, so there is nothing left for SERVICE to resolve.
ex:CQ2 a unit:CompetencyQuestionVerification ;
    rdfs:label "CQ2 - Hierarchy traversal" ;
    unit:testsOntology ex:WikidataTruthyDataset ;
    unit:hasInputTestDataCategory unit:SPARQLendpoint ;
    unit:hasCompetencyQuestion "What entities fall under the administrative/locational hierarchy of Gweru, Zimbabwe?" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>

SELECT ?item ?label WHERE {
  ?item wdt:P131+ wd:Q399316 .
  ?item rdfs:label ?label . FILTER(LANG(?label)="en")
} LIMIT 20
""" .

#################################################################
# CQ3 — Multi-hop join
#
# The SERVICE-resolved variant is noticeably slower (~15s cold) than the
# hardcoded one, but comfortably inside the 30s timeout -- this is a known,
# accepted cost, not a bug. "?city ?popProp ?pop" can't be narrowed to the
# real "population" property (P1082) until the SERVICE call resolves it,
# so QLever scans broadly first and filters afterwards, instead of the
# other way around.
#
# Subquery isolation (see CQ9) doesn't help here: "?city ?popProp ?pop"'s
# downstream constraint is a numeric FILTER, not another join, so there's
# no competing scan to avoid cross-joining against.
#################################################################

ex:CQ3 a unit:CompetencyQuestionVerification ;
    rdfs:label "CQ3 - Multi-hop join" ;
    unit:testsOntology ex:WikidataTruthyDataset ;
    unit:hasInputTestDataCategory unit:SPARQLendpoint ;
    unit:hasCompetencyQuestion "Which cities in Germany have a population over 500,000 and were founded before the year 1200?" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?city ?label ?pop ?inception WHERE {
  ?city wdt:P17 wd:Q183 .
  ?city wdt:P31/wdt:P279* wd:Q515 .
  ?city wdt:P1082 ?pop .
  ?city wdt:P571 ?inception .
  FILTER(?pop > 500000)
  FILTER(?inception < "1200-01-01T00:00:00"^^xsd:dateTime)
  ?city rdfs:label ?label . FILTER(LANG(?label)="en")
} ORDER BY ?inception
""" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX mwapi: <https://www.mediawiki.org/ontology#API/>

SELECT DISTINCT ?city ?label ?pop ?inception WHERE {
  # mwapi:bind for all five phrases -- NOT mwapi:searchRelation for
  # "instance of"/"city", because they're not directly related here:
  # ?instanceOfProp's object is ?cls, joined to ?cityClass through a
  # wdt:P279* subclass hop, not the same triple.
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:search "country" ; mwapi:type "property" ; mwapi:bind ?countryProp .
    [] mwapi:search "instance of" ; mwapi:type "property" ; mwapi:bind ?instanceOfProp .
    [] mwapi:search "population" ; mwapi:type "property" ; mwapi:bind ?popProp .
    [] mwapi:search "inception" ; mwapi:type "property" ; mwapi:bind ?inceptionProp .
    [] mwapi:search "city" ; mwapi:type "item" ; mwapi:bind ?cityClass .
  }
  ?city ?countryProp wd:Q183 .
  ?city ?instanceOfProp ?cls .
  ?cls wdt:P279* ?cityClass .
  ?city ?popProp ?pop .
  ?city ?inceptionProp ?inception .
  FILTER(?pop > 500000)
  FILTER(?inception < "1200-01-01T00:00:00"^^xsd:dateTime)
  ?city rdfs:label ?label . FILTER(LANG(?label)="en")
} ORDER BY ?inception
""" .

#################################################################
# CQ4 — Aggregation / ranking
#################################################################

ex:CQ4 a unit:CompetencyQuestionVerification ;
    rdfs:label "CQ4 - Aggregation and ranking" ;
    unit:testsOntology ex:WikidataTruthyDataset ;
    unit:hasInputTestDataCategory unit:SPARQLendpoint ;
    unit:hasCompetencyQuestion "Which countries have produced the most Nobel Prize laureates in Physics, ranked from most to least?" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>

SELECT ?countryLabel (COUNT(DISTINCT ?person) AS ?count) WHERE {
  ?person wdt:P166 wd:Q38104 .
  ?person wdt:P27 ?country .
  ?country rdfs:label ?countryLabel . FILTER(LANG(?countryLabel)="en")
} GROUP BY ?countryLabel ORDER BY DESC(?count) LIMIT 10
""" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX mwapi: <https://www.mediawiki.org/ontology#API/>

SELECT ?countryLabel (COUNT(DISTINCT ?person) AS ?count) WHERE {
  # mwapi:searchRelation, split into two identical calls, one per output
  # variable: a single call binding both ?awardProp and ?nobelPhysics into
  # the same triple can make QLever's planner choose a catastrophic plan
  # (see CLAUDE.md's SERVICE syntax reference for the general rule). The
  # joint phrase here also disambiguates "award received" from the
  # individually-plausible "nominated for".
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:searchRelation "received the Nobel Prize in Physics" ;
       mwapi:bindProperty ?awardProp ;
       mwapi:bindItem ?nobelPhysicsA .
  }
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:searchRelation "received the Nobel Prize in Physics" ;
       mwapi:bindProperty ?awardPropB ;
       mwapi:bindItem ?nobelPhysics .
  }
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:search "country of citizenship" ; mwapi:type "property" ; mwapi:bind ?citizenshipProp .
  }
  ?person ?awardProp ?nobelPhysics .
  ?person ?citizenshipProp ?country .
  ?country rdfs:label ?countryLabel . FILTER(LANG(?countryLabel)="en")
} GROUP BY ?countryLabel ORDER BY DESC(?count) LIMIT 10
""" .

#################################################################
# CQ5 — Disambiguation via type/context constraints
#################################################################

ex:CQ5 a unit:CompetencyQuestionVerification ;
    rdfs:label "CQ5 - Disambiguation via context constraint" ;
    unit:testsOntology ex:WikidataTruthyDataset ;
    unit:hasInputTestDataCategory unit:SPARQLendpoint ;
    unit:hasCompetencyQuestion "What is the population of Springfield, Illinois?" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>

SELECT DISTINCT ?item ?label ?pop WHERE {
  ?item rdfs:label "Springfield"@en .
  ?item wdt:P131* wd:Q1204 .
  ?item wdt:P1082 ?pop .
  BIND("Springfield"@en AS ?label)
}
""" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX mwapi: <https://www.mediawiki.org/ontology#API/>
PREFIX bd: <http://www.bigdata.com/rdf#>

SELECT DISTINCT ?item ?label ?pop WHERE {
  SERVICE <http://localhost:7002/sparql> {
    bd:serviceParam mwapi:search "population" .
    bd:serviceParam mwapi:type "property" .
    bd:serviceParam wikibase:limit "1" .
    ?popProp wikibase:apiOutput mwapi:directProperty .
  }
  ?item rdfs:label "Springfield"@en .
  ?item wdt:P131* wd:Q1204 .
  ?item ?popProp ?pop .
  BIND("Springfield"@en AS ?label)
}
""" .

#################################################################
# CQ6 — Cross-domain fact linking
#
# wdt:P1376 ("capital of") is not restricted to sovereign countries --
# Wikidata also uses it for capitals of states/provinces (e.g. Munich is
# "capital of" Bavaria) and historical polities (e.g. Constantinople was
# "capital of" the Byzantine Empire). Both query variants add a type check,
# "?country wdt:P31 wd:Q6256" (instance of country), to exclude those false
# positives and keep only real national capitals.
#################################################################

ex:CQ6 a unit:CompetencyQuestionVerification ;
    rdfs:label "CQ6 - Cross-domain fact linking" ;
    unit:testsOntology ex:WikidataTruthyDataset ;
    unit:hasInputTestDataCategory unit:SPARQLendpoint ;
    unit:hasCompetencyQuestion "Which breweries headquartered in national capitals were founded before 1900?" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?company ?label ?cityLabel ?inception WHERE {
  ?country wdt:P31 wd:Q6256 .
  ?city wdt:P1376 ?country .
  ?company wdt:P159 ?city .
  ?company wdt:P31 wd:Q131734 .
  ?company wdt:P571 ?inception .
  FILTER(?inception < "1900-01-01T00:00:00"^^xsd:dateTime)
  ?company rdfs:label ?label . FILTER(LANG(?label)="en")
  ?city rdfs:label ?cityLabel . FILTER(LANG(?cityLabel)="en")
} ORDER BY ?inception LIMIT 15
""" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX mwapi: <https://www.mediawiki.org/ontology#API/>

SELECT DISTINCT ?company ?label ?cityLabel ?inception WHERE {
  # mwapi:searchRelation, split into two identical calls, one per output
  # variable -- same reason as CQ4 (see CLAUDE.md's SERVICE syntax
  # reference). Unlike CQ3, "?company ?instanceOfProp ?breweryClass" is a
  # direct triple here, so the relation form's live-verification applies
  # cleanly.
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:searchRelation "instance of brewery" ;
       mwapi:bindProperty ?instanceOfProp ;
       mwapi:bindItem ?breweryClassA .
  }
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:searchRelation "instance of brewery" ;
       mwapi:bindProperty ?instanceOfPropB ;
       mwapi:bindItem ?breweryClass .
  }
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:search "headquarters location" ; mwapi:type "property" ; mwapi:bind ?hqProp .
    [] mwapi:search "inception" ; mwapi:type "property" ; mwapi:bind ?inceptionProp .
  }
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:search "capital of" ; mwapi:type "property" ; mwapi:bind ?capitalOfProp .
  }
  ?country wdt:P31 wd:Q6256 .
  ?city ?capitalOfProp ?country .
  ?company ?hqProp ?city .
  ?company ?inceptionProp ?inception .
  FILTER(?inception < "1900-01-01T00:00:00"^^xsd:dateTime)
  ?company ?instanceOfProp ?breweryClass .
  ?company rdfs:label ?label . FILTER(LANG(?label)="en")
  ?city rdfs:label ?cityLabel . FILTER(LANG(?cityLabel)="en")
} ORDER BY ?inception LIMIT 15
""" .

#################################################################
# CQ7 — Bounded-depth hierarchy traversal, fully dynamic
#
# Variant of CQ2 that avoids the wdt:P131+ property-path modifier: `+`/`*`
# can't apply to a SERVICE-resolved variable predicate (QLever rejects
# "?prop+" as a parse error), so this unrolls two explicit hops instead of
# one unbounded-recursion triple. Nothing is hardcoded -- the entity
# resolves via rdfs:label, and "located in the administrative territorial
# entity" resolves via SERVICE *twice*, once per hop, into two separate
# variables (?locatedInProp1/?locatedInProp2) rather than reusing one
# variable across both triples. Reusing a single SERVICE-bound variable
# across two different index-scan positions is its own unconstrained-scan
# risk -- resolving it twice, cheaply (repeat resolutions of an
# already-seen phrase are cache-fast, not a second LLM round trip),
# sidesteps it.
#################################################################

ex:CQ7 a unit:CompetencyQuestionVerification ;
    rdfs:label "CQ7 - Bounded-depth hierarchy traversal (dynamic CQ2 variant)" ;
    unit:testsOntology ex:WikidataTruthyDataset ;
    unit:hasInputTestDataCategory unit:SPARQLendpoint ;
    unit:hasCompetencyQuestion "What are Gweru, Zimbabwe's parent administrative region and that region's parent country?" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX mwapi: <https://www.mediawiki.org/ontology#API/>

SELECT ?regionLabel ?countryLabel WHERE {
  # mwapi:bind: the same phrase resolved twice into distinct variables, one
  # round trip -- see the header comment above for why each hop needs its
  # own variable.
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:search "located in the administrative territorial entity" ; mwapi:type "property" ; mwapi:bind ?locatedInProp1 .
    [] mwapi:search "located in the administrative territorial entity" ; mwapi:type "property" ; mwapi:bind ?locatedInProp2 .
  }
  ?gweru rdfs:label "Gweru"@en .
  ?gweru ?locatedInProp1 ?region .
  ?region ?locatedInProp2 ?country .
  ?region rdfs:label ?regionLabel . FILTER(LANG(?regionLabel)="en")
  ?country rdfs:label ?countryLabel . FILTER(LANG(?countryLabel)="en")
}
""" .

#################################################################
# CQ8 — Disambiguation via single-hop relation, fully dynamic
#
# Variant of CQ5 that avoids the wdt:P131* property-path modifier by
# disambiguating "Springfield" through a single-hop "capital" relation
# (P36) instead of an unbounded administrative-hierarchy walk. Nothing is
# hardcoded: "Illinois" resolves via rdfs:label (12 label-alike candidates
# exist, but only the real state has a P36 capital with a P1082 population,
# so the join naturally disambiguates it), and both properties resolve via
# SERVICE.
#################################################################

ex:CQ8 a unit:CompetencyQuestionVerification ;
    rdfs:label "CQ8 - Disambiguation via single-hop relation (dynamic CQ5 variant)" ;
    unit:testsOntology ex:WikidataTruthyDataset ;
    unit:hasInputTestDataCategory unit:SPARQLendpoint ;
    unit:hasCompetencyQuestion "What is the population of the Springfield that is the capital of Illinois?" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX mwapi: <https://www.mediawiki.org/ontology#API/>
PREFIX bd: <http://www.bigdata.com/rdf#>

SELECT ?item ?label ?pop WHERE {
  SERVICE <http://localhost:7002/sparql> {
    bd:serviceParam mwapi:search "capital" .
    bd:serviceParam mwapi:type "property" .
    bd:serviceParam wikibase:limit "1" .
    ?capitalProp wikibase:apiOutput mwapi:directProperty .
  }
  SERVICE <http://localhost:7002/sparql> {
    bd:serviceParam mwapi:search "population" .
    bd:serviceParam mwapi:type "property" .
    bd:serviceParam wikibase:limit "1" .
    ?popProp wikibase:apiOutput mwapi:directProperty .
  }
  ?illinois rdfs:label "Illinois"@en .
  ?illinois ?capitalProp ?item .
  ?item ?popProp ?pop .
  ?item rdfs:label ?label . FILTER(LANG(?label)="en")
}
""" .

#################################################################
# CQ9 — SERVICE-bound predicate whose object feeds a further join
#
# A SERVICE-bound-predicate triple whose object joins into a plain
# (non-SERVICE-bound) triple -- here, resolving "place of death" then
# looking up that place's rdfs:label -- can make QLever plan the triple
# as an unbound-predicate scan of the whole dataset instead of pushing
# down the already-resolved equality filter, then join that against the
# other large scan. Hangs to the timeout; not specific to OPTIONAL.
#
# Fix: isolate the SERVICE-bound-predicate triple alone (not its
# downstream join) in its own subquery:
# { SELECT ?item ?deathPlace WHERE { SERVICE {...} ; ?item ?deathProp
# ?deathPlace . } }
#################################################################

ex:CQ9 a unit:CompetencyQuestionVerification ;
    rdfs:label "CQ9 - SERVICE-bound predicate object feeding a further join" ;
    unit:testsOntology ex:WikidataTruthyDataset ;
    unit:hasInputTestDataCategory unit:SPARQLendpoint ;
    unit:hasCompetencyQuestion "When was Lise Meitner born, and where did she die?" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>

SELECT ?item ?label ?birth ?deathPlaceLabel WHERE {
  ?item rdfs:label "Lise Meitner"@en .
  ?item wdt:P31 wd:Q5 ;
        wdt:P569 ?birth ;
        rdfs:label ?label .
  OPTIONAL {
    ?item wdt:P20 ?deathPlace .
    ?deathPlace rdfs:label ?deathPlaceLabel . FILTER(LANG(?deathPlaceLabel)="en")
  }
  FILTER(LANG(?label) = "en")
}
""" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX mwapi: <https://www.mediawiki.org/ontology#API/>

SELECT ?item ?label ?birth ?deathPlaceLabel WHERE {
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:search "date of birth" ; mwapi:type "property" ; mwapi:bind ?birthProp .
  }
  ?item rdfs:label "Lise Meitner"@en .
  ?item wdt:P31 wd:Q5 ;
        ?birthProp ?birth ;
        rdfs:label ?label .
  # Subquery isolation required here -- see the header comment above.
  # Without it, "?item ?deathProp ?deathPlace" plans as an
  # unbound-predicate scan joined to the label lookup and hangs.
  OPTIONAL {
    {
      SELECT ?item ?deathPlace WHERE {
        SERVICE <http://localhost:7002/sparql> {
          [] mwapi:search "place of death" ; mwapi:type "property" ; mwapi:bind ?deathProp .
        }
        ?item ?deathProp ?deathPlace .
      }
    }
    ?deathPlace rdfs:label ?deathPlaceLabel . FILTER(LANG(?deathPlaceLabel)="en")
  }
  FILTER(LANG(?label) = "en")
}
""" .

#################################################################
# CQ10 — Negation (absence of a fact)
#
# None of CQ1-9 filter on the ABSENCE of a triple -- every existing filter
# constrains on presence, or a numeric/date range. Wikidata models "first
# ascent" not as a dedicated property but as a qualified wdt:P793
# ("significant event") value of wd:Q1194369 ("first ascent") -- a
# property+item PAIR, not a single obvious predicate. (A plausible-looking
# wdt:P1249 is a red herring: it means "time of earliest written record"
# and has zero matches on any Bhutanese mountain -- verify what a property
# actually means before trusting its name.)
#
# The naive SERVICE-resolved variant is NOT viable: resolving "significant
# event"/"first ascent" jointly via mwapi:searchRelation and using the
# resulting property+item pair inside FILTER NOT EXISTS (or MINUS, even
# isolated into its own subquery exactly as CQ9 prescribes) both trigger
# the unbound-predicate-object hazard at full scale (confirmed: a 65 GB
# allocation attempt). The problem is specifically searchRelation's joint
# two-variable binding, not negation or subquery isolation themselves --
# confirmed by swapping in a working fix: resolve the property alone via
# plain mwapi:search/mwapi:bind, resolve the item via a direct rdfs:label
# exact-match (the CQ12 pattern) instead of mwapi:searchRelation, and
# isolate the SERVICE+join in its own subquery (the CQ9 pattern). With a
# single independently-resolved SERVICE-bound variable, both FILTER NOT
# EXISTS and MINUS work fine and return output identical to the hardcoded
# baseline.
#################################################################

ex:CQ10 a unit:CompetencyQuestionVerification ;
    rdfs:label "CQ10 - Negation (absence of a fact)" ;
    unit:testsOntology ex:WikidataTruthyDataset ;
    unit:hasInputTestDataCategory unit:SPARQLendpoint ;
    unit:hasCompetencyQuestion "Which mountains in Bhutan have no recorded first ascent?" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>

SELECT ?item ?label WHERE {
  ?item wdt:P31 wd:Q8502 ;
        wdt:P17 wd:Q917 ;
        rdfs:label ?label .
  FILTER(LANG(?label) = "en")
  FILTER NOT EXISTS { ?item wdt:P793 wd:Q1194369 }
}
""" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX mwapi: <https://www.mediawiki.org/ontology#API/>

SELECT ?item ?label WHERE {
  ?item wdt:P31 wd:Q8502 ;
        wdt:P17 wd:Q917 ;
        rdfs:label ?label .
  FILTER(LANG(?label) = "en")
  # Property resolved alone via plain mwapi:search (NOT mwapi:searchRelation
  # -- see the header comment above), item resolved via a direct rdfs:label
  # exact-match, and the whole join isolated in its own subquery per CQ9.
  # This combination is what makes FILTER NOT EXISTS safe here.
  FILTER NOT EXISTS {
    SELECT ?item WHERE {
      SERVICE <http://localhost:7002/sparql> {
        [] mwapi:search "significant event" ; mwapi:type "property" ; mwapi:bind ?eventProp .
      }
      ?firstAscent rdfs:label "first ascent"@en .
      ?item ?eventProp ?firstAscent .
    }
  }
}
""" .

#################################################################
# CQ11 — Symmetric relation stored in only one direction
#
# Wikidata does not always store a symmetric relation (e.g. wdt:P26,
# spouse) as a pair of reciprocal triples -- many pairs are recorded in
# only ONE direction. A query that assumes the resolved entity is always
# the SUBJECT (as every prior exemplar does) silently returns zero results
# for an entity that only appears as the OBJECT -- not an error, just a
# wrong/incomplete answer. The fix is a UNION over both directions, not a
# single hardcoded direction.
#
# A naive SERVICE-resolved variant is NOT viable: resolving "spouse" once
# via SERVICE and reusing that single variable predicate across both
# branches of a two-direction UNION triggers the same unbound-predicate-
# object hazard as CQ9, even when the whole SERVICE+UNION cluster is
# isolated into its own subquery per CQ9's fix (confirmed: still hits the
# 30s timeout). The fix, confirmed working: resolve "spouse" *separately
# per UNION branch*, each into its own variable (?spouseProp1/
# ?spouseProp2, the CQ7 pattern of resolving one phrase twice), with each
# branch's SERVICE+join isolated in its own subquery (the CQ9 pattern).
# Repeat resolution of an already-seen phrase is cache-fast, not a second
# LLM round trip.
#################################################################

ex:CQ11 a unit:CompetencyQuestionVerification ;
    rdfs:label "CQ11 - Symmetric relation stored in only one direction" ;
    unit:testsOntology ex:WikidataTruthyDataset ;
    unit:hasInputTestDataCategory unit:SPARQLendpoint ;
    unit:hasCompetencyQuestion "Who is Cecilia Ștefănescu's spouse?" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>

SELECT ?spouseLabel WHERE {
  ?item rdfs:label "Cecilia Ștefănescu"@en .
  { ?item wdt:P26 ?spouse } UNION { ?spouse wdt:P26 ?item }
  ?spouse rdfs:label ?spouseLabel . FILTER(LANG(?spouseLabel) = "en")
}
""" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX mwapi: <https://www.mediawiki.org/ontology#API/>

SELECT ?spouseLabel WHERE {
  # "spouse" resolved separately per branch, into its own variable, each
  # isolated in its own subquery -- see the header comment above. Sharing
  # one SERVICE-bound variable across both UNION branches is the hazard;
  # this sidesteps it.
  {
    SELECT ?spouse WHERE {
      SERVICE <http://localhost:7002/sparql> {
        [] mwapi:search "spouse" ; mwapi:type "property" ; mwapi:bind ?spouseProp1 .
      }
      ?item rdfs:label "Cecilia Ștefănescu"@en .
      ?item ?spouseProp1 ?spouse .
    }
  }
  UNION
  {
    SELECT ?spouse WHERE {
      SERVICE <http://localhost:7002/sparql> {
        [] mwapi:search "spouse" ; mwapi:type "property" ; mwapi:bind ?spouseProp2 .
      }
      ?item rdfs:label "Cecilia Ștefănescu"@en .
      ?spouse ?spouseProp2 ?item .
    }
  }
  ?spouse rdfs:label ?spouseLabel . FILTER(LANG(?spouseLabel) = "en")
}
""" .

#################################################################
# CQ12 — Two independent relation pairs joined on a shared subject
#
# CQ4/CQ6 already document that a single mwapi:searchRelation pair whose
# two output variables both feed one unconstrained-subject triple must be
# split into two identical per-variable SERVICE calls. This is a
# different, MORE SEVERE hazard: two DIFFERENT relation pairs (different
# phrases, different properties/items), each individually split per the
# CQ4/CQ6 fix, then joined only by sharing the same unconstrained ?person
# variable across both triples. Confirmed: this still triggers a 30s
# timeout ("Join on ?awardProp") even after applying the per-variable
# split to both relations -- that fix only helps within a single
# relation's own two output variables, not across two unrelated relations
# sharing a subject.
#
# Fix: don't resolve either award as a joint property+item pair at all.
# Resolve the shared property ("award received") ONCE via a plain
# mwapi:search/mwapi:bind, and resolve each award ITEM via a direct
# rdfs:label exact-match instead of mwapi:searchRelation -- both awards
# are already well-known named entities, so nothing is lost by skipping
# the joint-context verification that searchRelation exists for. This
# avoids ever having two distinct SERVICE-bound variable predicates in
# play at once.
#################################################################

ex:CQ12 a unit:CompetencyQuestionVerification ;
    rdfs:label "CQ12 - Two independent relation pairs sharing a subject" ;
    unit:testsOntology ex:WikidataTruthyDataset ;
    unit:hasInputTestDataCategory unit:SPARQLendpoint ;
    unit:hasCompetencyQuestion "Which people have received both the Copley Medal and the Nobel Prize in Chemistry?" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX wd: <http://www.wikidata.org/entity/>

SELECT ?person ?personLabel WHERE {
  ?person wdt:P166 wd:Q28003 .
  ?person wdt:P166 wd:Q44585 .
  ?person rdfs:label ?personLabel . FILTER(LANG(?personLabel) = "en")
} ORDER BY ?personLabel
""" ;
    unit:hasSPARQLQueryUnitTest """
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX mwapi: <https://www.mediawiki.org/ontology#API/>

SELECT ?person ?personLabel WHERE {
  # Single shared-property resolution, NOT two mwapi:searchRelation calls --
  # see the header comment above for why two joint property+item
  # resolutions sharing a subject is a worse hazard than either CQ4/CQ6's
  # single-relation case or CQ9's single-object case.
  SERVICE <http://localhost:7002/sparql> {
    [] mwapi:search "award received" ; mwapi:type "property" ; mwapi:bind ?awardProp .
  }
  ?copleyMedal rdfs:label "Copley Medal"@en .
  ?nobelChemistry rdfs:label "Nobel Prize in Chemistry"@en .
  ?person ?awardProp ?copleyMedal .
  ?person ?awardProp ?nobelChemistry .
  ?person rdfs:label ?personLabel . FILTER(LANG(?personLabel) = "en")
} ORDER BY ?personLabel
""" .
